<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.Maui.FeatureFlags.Sample.MainPage"
             Title="Feature flags">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">
            <Label Text="Plugin.Maui.FeatureFlags" FontSize="22" FontAttributes="Bold" />
            <Label Text="Remote → Device → OS → Country → User → Rollout"
                   TextColor="Gray" />

            <Label x:Name="ContextLabel" FontSize="13" LineBreakMode="WordWrap" />

            <Label Text="Environment" FontAttributes="Bold" Margin="0,8,0,0" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Dev" Clicked="OnDevClicked" />
                <Button Text="Staging" Clicked="OnStagingClicked" />
                <Button Text="Production" Clicked="OnProductionClicked" />
            </HorizontalStackLayout>

            <Entry x:Name="UserEntry" Placeholder="User id (user-42)" />
            <Entry x:Name="CountryEntry" Placeholder="Country (US, IN)" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Identify" Clicked="OnIdentifyClicked" />
                <Button Text="Clear user" Clicked="OnClearUserClicked" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh" Clicked="OnRefreshClicked" />
                <Button Text="Override checkout ON" Clicked="OnOverrideClicked" />
            </HorizontalStackLayout>

            <Label Text="Evaluations" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label x:Name="FlagsLabel" FontFamily="Courier New" FontSize="13" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
